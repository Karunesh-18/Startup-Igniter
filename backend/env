# =====================================================
# Startup OS — Backend Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# Share values only via a password manager (Bitwarden / 1Password).

# --- Supabase ------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Full Postgres connection string (from Supabase → Settings → Database)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Redis (Upstash) ------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Groq -----------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_HEAVY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# --- OpenRouter -----------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_HEAVY=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_FAST=meta-llama/llama-3.1-8b-instruct

# --- HuggingFace ----------------------------------------
HF_TOKEN=your_hf_token_here

# --- Search & Scraping ----------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here
ZYTE_API_KEY=your_zyte_api_key_here

# --- Research APIs (optional / no-key) ------------------
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=your@email.com

# --- App ------------------------------------------------
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# --- Storage (Supabase Storage bucket name) -------------
STORAGE_BUCKET=documents
