# =====================================================
# Startup OS — Backend Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# Share values only via a password manager (Bitwarden / 1Password).

# --- Supabase ------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Full Postgres connection string (from Supabase → Settings → Database)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Redis (Upstash) ------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- LLM: self-hosted (DGX B200 / vLLM) ------------------
# Preferred backend, tried first. Not reachable yet at time of writing --
# leave LLM_BASE_URL unset and the gateway falls through to the fallback
# provider below, then finally to a deterministic offline mock (never a
# hard crash). See ai/llm/gateway.py.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_HEAVY=Qwen/Qwen3-32B
LLM_MODEL_FAST=Qwen/Qwen3-8B
LLM_GUIDED_DECODING=true

# --- LLM: fallback provider -------------------------------
# 'auto' prefers OpenRouter over Groq if both are set (matches historical
# behavior); set to 'groq', 'openrouter', or 'none' to force a choice.
LLM_FALLBACK_BACKEND=auto

# --- Groq (fallback option 1) ----------------------------
GROQ_API_KEY=gsk_...
GROQ_MODEL_HEAVY=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# --- OpenRouter (fallback option 2) ----------------------
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL_HEAVY=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_FAST=meta-llama/llama-3.1-8b-instruct

# --- Search & Scraping ----------------------------------
TAVILY_API_KEY=tvly-...
EXA_API_KEY=your-exa-key
ZYTE_API_KEY=your-zyte-key
ZYTE_ENABLED=false

# --- Research APIs (optional / no-key) ------------------
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=your@email.com

# --- App ------------------------------------------------
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# --- Storage (Supabase Storage bucket name) -------------
STORAGE_BUCKET=documents
