# =====================================================
# Startup OS — Backend Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# Share values only via a password manager (Bitwarden / 1Password).

# --- Supabase ------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Full Postgres connection string (from Supabase → Settings → Database)
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Redis (Upstash) ------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- LLM: self-hosted (DGX B200 / vLLM) ------------------
# The only real LLM backend (no paid APIs). If LLM_BASE_URL is unset or
# unreachable the gateway falls through to a deterministic offline mock,
# but only while LLM_ALLOW_MOCK=false. See ai/llm/gateway.py.
LLM_BASE_URL=http://localhost:47001/v1   # DGX: vllm_up.sh heavy server
# Optional: only needed if FAST (Qwen3-8B) runs as a separate vLLM server
# from HEAVY/REASONING (Qwen3-32B) -- see training/serve/vllm_up.sh. Leave
# unset to route both tiers to LLM_BASE_URL.
LLM_BASE_URL_FAST=http://localhost:47002/v1   # DGX: vllm_up.sh fast server
LLM_API_KEY=
LLM_MODEL_HEAVY=Qwen/Qwen3-32B
LLM_MODEL_FAST=Qwen/Qwen3-8B
LLM_GUIDED_DECODING=true

# Mock fallback when the self-hosted server is down/unset. Fine for dev/CI;
# PRODUCTION SHOULD SET false so an outage fails loudly instead of returning
# placeholder analysis.
LLM_ALLOW_MOCK=false

# Web grounding is keyless (DuckDuckGo search + trafilatura extraction) --
# see ai/shared/research/web_provider.py. No env vars needed.

# --- Research APIs (optional / no-key) ------------------
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=your@email.com

# --- App ------------------------------------------------
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# --- Storage (Supabase Storage bucket name) -------------
STORAGE_BUCKET=documents
