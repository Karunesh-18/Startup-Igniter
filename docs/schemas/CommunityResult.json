        "type": "string"
      },
      "title": "Recommended Mentors",
      "type": "array"
    },
    "confidence_score": {
      "default": 0.88,
      "description": "Confidence score (0.0 to 1.0).",
      "title": "Confidence Score",
      "type": "number"
    }
  },
  "required": [
