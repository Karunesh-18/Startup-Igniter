{
  "$defs": {
    "MVPFeature": {
      "description": "Schema for individual MVP feature item.",
      "properties": {
        "feature_name": {
          "description": "Name of feature.",
          "title": "Feature Name",
          "type": "string"
        },
        "description": {
          "description": "Feature functionality summary.",
          "title": "Description",
          "type": "string"
        },
        "priority": {
          "default": "Must Have",
          "description": "Must Have, Should Have, Could Have.",
          "title": "Priority",
          "type": "string"
        },
        "complexity": {
          "default": "Medium",
          "description": "Low, Medium, High engineering effort.",
          "title": "Complexity",
          "type": "string"
        }
      },
      "required": [
        "feature_name",
        "description"
      ],
      "title": "MVPFeature",
      "type": "object"
    },
    "TechStackRecommendation": {
      "description": "Recommended tech stack components.",
      "properties": {
        "frontend": {
          "description": "Recommended frontend framework (e.g. Next.js / React).",
          "title": "Frontend",
          "type": "string"
        },
        "backend": {
          "description": "Recommended backend framework (e.g. FastAPI / Node.js).",
          "title": "Backend",
          "type": "string"
        },
        "database": {
          "description": "Recommended database (e.g. PostgreSQL / Supabase).",
          "title": "Database",
          "type": "string"
        },
        "hosting": {
          "description": "Recommended hosting cloud (e.g. Vercel / GCP).",
          "title": "Hosting",
          "type": "string"
        },
        "ai_ml_tools": {
          "description": "AI models or frameworks.",
          "items": {
            "type": "string"
          },
          "title": "Ai Ml Tools",
          "type": "array"
        }
      },
      "required": [
        "frontend",
        "backend",
        "database",
        "hosting"
      ],
      "title": "TechStackRecommendation",
      "type": "object"
    }
  },
  "description": "Unified result container for Product Development Crew.",
  "properties": {
    "project_id": {
      "description": "Project UUID string.",
      "title": "Project Id",
      "type": "string"
    },
    "mvp_features": {
      "description": "MVP feature roadmap.",
      "items": {
        "$ref": "#/$defs/MVPFeature"
      },
      "title": "Mvp Features",
      "type": "array"
    },
    "tech_stack": {
      "$ref": "#/$defs/TechStackRecommendation",
      "description": "Tech stack recommendation."
    },
    "architecture_overview": {
      "description": "System architecture description.",
      "title": "Architecture Overview",
      "type": "string"
    },
    "confidence_score": {
      "default": 0.85,
      "description": "Confidence score (0.0 to 1.0).",
      "title": "Confidence Score",
      "type": "number"
    }
  },
  "required": [
    "project_id",
    "tech_stack",
    "architecture_overview"
  ],
  "title": "ProductDevelopmentResult",
  "type": "object"
}
