{
  "$defs": {
    "ExistingSolutionAnalysis": {
      "description": "Schema representing commercial product, startup, and open-source landscape evaluation.",
      "properties": {
        "existing_startups": {
          "description": "Relevant venture-backed startups.",
          "items": {
            "type": "string"
          },
          "title": "Existing Startups",
          "type": "array"
        },
        "commercial_products": {
          "description": "Established commercial products.",
          "items": {
            "type": "string"
          },
          "title": "Commercial Products",
          "type": "array"
        },
        "enterprise_software": {
          "description": "Legacy enterprise suites.",
          "items": {
            "type": "string"
          },
          "title": "Enterprise Software",
          "type": "array"
        },
        "open_source_projects": {
          "description": "Key open-source projects / repos.",
          "items": {
            "type": "string"
          },
          "title": "Open Source Projects",
          "type": "array"
        },
        "existing_technologies": {
          "description": "Core technologies / stacks.",
          "items": {
            "type": "string"
          },
          "title": "Existing Technologies",
          "type": "array"
        },
        "market_maturity": {
          "default": "Growing",
          "description": "Market maturity stage.",
          "title": "Market Maturity",
          "type": "string"
        },
        "solution_gaps": {
          "description": "Deficiencies and functional gaps in current solutions.",
          "items": {
            "type": "string"
          },
          "title": "Solution Gaps",
          "type": "array"
        },
        "confidence_score": {
          "default": 0.9,
          "description": "Confidence score (0.0-1.0).",
          "title": "Confidence Score",
          "type": "number"
        },
        "reasoning_summary": {
          "default": "",
          "description": "Summary of product landscape analysis.",
          "title": "Reasoning Summary",
          "type": "string"
        },
        "recommendations": {
          "description": "Strategic product positioning recommendations.",
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "ExistingSolutionAnalysis",
      "type": "object"
    },
    "IPStrategy": {
      "description": "Schema representing intellectual property protection strategy and portfolio roadmap.",
      "properties": {
        "patent_strategy_recommendations": {
          "description": "Priority patent filing recommendations.",
          "items": {
            "type": "string"
          },
          "title": "Patent Strategy Recommendations",
          "type": "array"
        },
        "trade_secret_opportunities": {
          "description": "Proprietary trade secret protections.",
          "items": {
            "type": "string"
          },
          "title": "Trade Secret Opportunities",
          "type": "array"
        },
        "copyright_protection_areas": {
          "description": "Source code and design copyright areas.",
          "items": {
            "type": "string"
          },
          "title": "Copyright Protection Areas",
          "type": "array"
        },
        "licensing_considerations": {
          "description": "Commercial API and open-source licensing considerations.",
          "items": {
            "type": "string"
          },
          "title": "Licensing Considerations",
          "type": "array"
        },
        "defensive_ip_tactics": {
          "description": "Defensive publication and moat tactics.",
          "items": {
            "type": "string"
          },
          "title": "Defensive Ip Tactics",
          "type": "array"
        },
        "open_source_strategy": {
          "default": "Open-core model",
          "description": "Open-source vs proprietary licensing model strategy.",
          "title": "Open Source Strategy",
          "type": "string"
        },
        "ip_defensibility_score": {
          "default": 82.0,
          "description": "IP defensibility score (0-100).",
          "title": "Ip Defensibility Score",
          "type": "number"
        },
        "confidence_score": {
          "default": 0.9,
          "description": "Confidence score (0.0-1.0).",
          "title": "Confidence Score",
          "type": "number"
        },
        "reasoning_summary": {
          "default": "",
          "description": "IP portfolio rationale.",
          "title": "Reasoning Summary",
          "type": "string"
        },
        "recommendations": {
          "description": "Actionable IP steps.",
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "IPStrategy",
      "type": "object"
    },
    "InnovationGapAnalysis": {
      "description": "Schema representing technical, product, customer, and market gap identification.",
      "properties": {
        "technical_gaps": {
          "description": "Engineering or algorithmic capability gaps.",
          "items": {
            "type": "string"
          },
          "title": "Technical Gaps",
          "type": "array"
        },
        "product_gaps": {
          "description": "Product workflow or UI/UX gaps.",
          "items": {
            "type": "string"
          },
          "title": "Product Gaps",
          "type": "array"
        },
        "customer_gaps": {
          "description": "Underserved customer segment pain points.",
          "items": {
            "type": "string"
          },
          "title": "Customer Gaps",
          "type": "array"
        },
        "market_gaps": {
          "description": "Unexploited business model market gaps.",
          "items": {
            "type": "string"
          },
          "title": "Market Gaps",
          "type": "array"
        },
        "innovation_opportunities": {
          "description": "High-leverage technical innovation opportunities.",
          "items": {
            "type": "string"
          },
          "title": "Innovation Opportunities",
          "type": "array"
        },
        "differentiation_opportunities": {
          "description": "Defensible differentiation moats.",
          "items": {
            "type": "string"
          },
          "title": "Differentiation Opportunities",
          "type": "array"
        },
        "overall_gap_score": {
          "default": 85.0,
          "description": "Innovation gap score (0-100).",
          "title": "Overall Gap Score",
          "type": "number"
        },
        "confidence_score": {
          "default": 0.89,
          "description": "Confidence score (0.0-1.0).",
          "title": "Confidence Score",
          "type": "number"
        },
        "reasoning_summary": {
          "default": "",
          "description": "Rationale synthesizing all gaps.",
          "title": "Reasoning Summary",
          "type": "string"
        },
        "recommendations": {
          "description": "Actionable product and moat recommendations.",
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "InnovationGapAnalysis",
      "type": "object"
    },
    "PatentAnalysis": {
      "description": "Schema representing patent research and prior-art analysis.",
      "properties": {
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Project UUID string.",
          "title": "Project Id"
        },
        "patent_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Patent or application number.",
          "title": "Patent Number"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Prior-Art Patent Analysis",
          "description": "Title of patent or prior art.",
          "title": "Title"
        },
        "abstract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Abstract summary.",
          "title": "Abstract"
        },
        "similarity_score": {
          "default": 0.0,
          "description": "Prior-art similarity score.",
          "title": "Similarity Score",
          "type": "number"
        },
        "inventors": {
          "description": "List of inventors.",
          "items": {
            "type": "string"
          },
          "title": "Inventors",
          "type": "array"
        },
        "key_claims": {
          "description": "Key patent claims.",
          "items": {
            "type": "string"
          },
          "title": "Key Claims",
          "type": "array"
        },
        "existing_patent_summary": {
          "default": "",
          "description": "Summary of existing patents and prior art.",
          "title": "Existing Patent Summary",
          "type": "string"
        },
        "patent_landscape": {
          "default": "",
          "description": "Overview of patent density and filing volume.",
          "title": "Patent Landscape",
          "type": "string"
        },
        "major_patent_holders": {
          "description": "Top enterprise and academic assignees.",
          "items": {
            "type": "string"
          },
          "title": "Major Patent Holders",
          "type": "array"
        },
        "related_technology_domains": {
          "description": "IPC/CPC Technical classification domains.",
          "items": {
            "type": "string"
          },
          "title": "Related Technology Domains",
          "type": "array"
        },
        "patent_activity_level": {
          "default": "High",
          "description": "Activity level (Low, Moderate, High).",
          "title": "Patent Activity Level",
          "type": "string"
        },
        "potential_patent_conflicts": {
          "description": "Identified IP conflict observations.",
          "items": {
            "type": "string"
          },
          "title": "Potential Patent Conflicts",
          "type": "array"
        },
        "white_space_opportunities": {
          "description": "Unclaimed technological white spaces.",
          "items": {
            "type": "string"
          },
          "title": "White Space Opportunities",
          "type": "array"
        },
        "patentability_assessment": {
          "default": "",
          "description": "Evaluation of concept patentability.",
          "title": "Patentability Assessment",
          "type": "string"
        },
        "freedom_to_operate_observations": {
          "description": "Freedom to operate observations.",
          "items": {
            "type": "string"
          },
          "title": "Freedom To Operate Observations",
          "type": "array"
        },
        "innovation_opportunities": {
          "description": "Actionable differentiation vectors.",
          "items": {
            "type": "string"
          },
          "title": "Innovation Opportunities",
          "type": "array"
        },
        "patent_risks": {
          "description": "Identified IP risks or patent thicket threats.",
          "items": {
            "type": "string"
          },
          "title": "Patent Risks",
          "type": "array"
        },
        "novelty_assessment": {
          "default": "",
          "description": "Qualitative assessment of technical novelty.",
          "title": "Novelty Assessment",
          "type": "string"
        },
        "confidence_score": {
          "default": 0.85,
          "description": "Confidence score (0.0-1.0).",
          "title": "Confidence Score",
          "type": "number"
        },
        "citations": {
          "description": "Source URLs backing the analysis above, when external patent-office scrapes were supplied.",
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "title": "PatentAnalysis",
      "type": "object"
    },
    "ResearchPaperAnalysis": {
      "description": "Schema representing academic research paper & scientific literature analysis.",
      "properties": {
        "key_research_papers": {
          "description": "Foundational and benchmark research papers.",
          "items": {
            "type": "string"
          },
          "title": "Key Research Papers",
          "type": "array"
        },
        "state_of_the_art_methods": {
          "description": "State-of-the-art algorithms and models.",
          "items": {
            "type": "string"
          },
          "title": "State Of The Art Methods",
          "type": "array"
        },
        "academic_innovations": {
          "description": "Recent theoretical breakthroughs.",
          "items": {
            "type": "string"
          },
          "title": "Academic Innovations",
          "type": "array"
        },
        "open_problems": {
          "description": "Unsolved academic research problems.",
          "items": {
            "type": "string"
          },
          "title": "Open Problems",
          "type": "array"
        },
        "technical_limitations": {
          "description": "Computational or algorithmic bottlenecks.",
          "items": {
            "type": "string"
          },
          "title": "Technical Limitations",
          "type": "array"
        },
        "emerging_research_trends": {
          "description": "Emerging research directions.",
          "items": {
            "type": "string"
          },
          "title": "Emerging Research Trends",
          "type": "array"
        },
        "academic_novelty_score": {
          "default": 80.0,
          "description": "Academic novelty rating (0-100).",
          "title": "Academic Novelty Score",
          "type": "number"
        },
        "confidence_score": {
          "default": 0.88,
          "description": "Confidence score (0.0-1.0).",
          "title": "Confidence Score",
          "type": "number"
        },
        "reasoning_summary": {
          "default": "",
          "description": "Detailed reasoning summary.",
          "title": "Reasoning Summary",
          "type": "string"
        },
        "recommendations": {
          "description": "Strategic recommendations.",
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "ResearchPaperAnalysis",
      "type": "object"
    },
    "TechnologyReadiness": {
      "description": "Schema representing Technology Readiness Level (TRL) and feasibility assessment.",
      "properties": {
        "trl_level": {
          "default": 3,
          "description": "TRL rating from 1 to 9.",
          "title": "Trl Level",
          "type": "integer"
        },
        "trl_stage_name": {
          "default": "TRL 3: Proof of Concept",
          "description": "Human-readable TRL stage name.",
          "title": "Trl Stage Name",
          "type": "string"
        },
        "technical_feasibility_assessment": {
          "default": "",
          "description": "Feasibility evaluation.",
          "title": "Technical Feasibility Assessment",
          "type": "string"
        },
        "infrastructure_complexity": {
          "default": "Moderate",
          "description": "Complexity level (Low, Moderate, High, Extreme).",
          "title": "Infrastructure Complexity",
          "type": "string"
        },
        "engineering_complexity": {
          "default": "High",
          "description": "Engineering complexity (Low, Moderate, High, Extreme).",
          "title": "Engineering Complexity",
          "type": "string"
        },
        "technology_dependencies": {
          "description": "Third-party frameworks and infrastructure dependencies.",
          "items": {
            "type": "string"
          },
          "title": "Technology Dependencies",
          "type": "array"
        },
        "scalability_assessment": {
          "default": "",
          "description": "Assessment of system scalability bottlenecks.",
          "title": "Scalability Assessment",
          "type": "string"
        },
        "development_risks": {
          "description": "Key technical execution risks.",
          "items": {
            "type": "string"
          },
          "title": "Development Risks",
          "type": "array"
        },
        "estimated_time_to_mvp_months": {
          "default": 4,
          "description": "Estimated months to functional MVP.",
          "title": "Estimated Time To Mvp Months",
          "type": "integer"
        },
        "confidence_score": {
          "default": 0.88,
          "description": "Confidence score (0.0-1.0).",
          "title": "Confidence Score",
          "type": "number"
        },
        "reasoning_summary": {
          "default": "",
          "description": "Detailed technical rationale.",
          "title": "Reasoning Summary",
          "type": "string"
        },
        "recommendations": {
          "description": "Engineering and infrastructure derisking recommendations.",
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "TechnologyReadiness",
      "type": "object"
    }
  },
  "description": "Unified master output model for Research & Patent Analysis Crew (Crew 3).",
  "properties": {
    "project_id": {
      "description": "Unique project UUID string identifier.",
      "title": "Project Id",
      "type": "string"
    },
    "startup_idea_text": {
      "default": "",
      "description": "Submitted raw startup proposal text.",
      "title": "Startup Idea Text",
      "type": "string"
    },
    "patent_analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/PatentAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Prior-art patent search analysis."
    },
    "research_paper_analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchPaperAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Academic literature analysis."
    },
    "existing_solution_analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingSolutionAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Commercial & open-source landscape evaluation."
    },
    "innovation_gap_analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/InnovationGapAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Technical, product, customer & market gap analysis."
    },
    "technology_readiness": {
      "anyOf": [
        {
          "$ref": "#/$defs/TechnologyReadiness"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "TRL rating & technical feasibility assessment."
    },
    "ip_strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/IPStrategy"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Intellectual property strategy & roadmap."
    },
    "overall_novelty_score": {
      "default": 85.0,
      "description": "Composite novelty score (0-100).",
      "title": "Overall Novelty Score",
      "type": "number"
    },
    "trl_level": {
      "default": 3,
      "description": "Master TRL level (1-9).",
      "title": "Trl Level",
      "type": "integer"
    },
    "confidence_score": {
      "default": 0.88,
      "description": "Average confidence score (0.0-1.0).",
      "title": "Confidence Score",
      "type": "number"
    },
    "executive_summary": {
      "default": "",
      "description": "Executive summary synthesizing all research & IP findings.",
      "title": "Executive Summary",
      "type": "string"
    },
    "strategic_recommendations": {
      "description": "Top strategic recommendations.",
      "items": {
        "type": "string"
      },
      "title": "Strategic Recommendations",
      "type": "array"
    },
    "status": {
      "default": "success",
      "description": "Execution status ('success' | 'failed').",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "ResearchPatentResult",
  "type": "object"
}
